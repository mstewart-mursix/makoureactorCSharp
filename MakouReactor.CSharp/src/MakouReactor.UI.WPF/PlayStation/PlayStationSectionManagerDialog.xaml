<Window x:Class="MakouReactor.UI.WPF.PlayStation.PlayStationSectionManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PlayStation Sections"
        Height="560"
        Width="860"
        MinHeight="420"
        MinWidth="700"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#666" Text="{Binding StatusText}"/>
            <Button Width="86" IsDefault="True" IsCancel="True">Close</Button>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Margin="0,0,0,8"
                       FontWeight="SemiBold"
                       Text="{Binding FieldName, StringFormat=Field: {0}}"/>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ToolBarTray Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
                    <ToolBar>
                        <Button x:Name="ExportRawSectionButton"
                                Padding="8,2"
                                Content="Export Raw..."
                                IsEnabled="{Binding HasSelectedSection}"
                                Click="ExportRawSection_Click"/>
                        <Button x:Name="ReplaceRawSectionButton"
                                Padding="8,2"
                                Content="Replace Raw..."
                                IsEnabled="{Binding HasSelectedSection}"
                                Click="ReplaceRawSection_Click"/>
                    </ToolBar>
                </ToolBarTray>

                <ListView Grid.Row="1"
                          Grid.Column="0"
                          ItemsSource="{Binding Sections}"
                          SelectedItem="{Binding SelectedSection, Mode=TwoWay}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="#" DisplayMemberBinding="{Binding Index}" Width="42"/>
                            <GridViewColumn Header="Section" DisplayMemberBinding="{Binding Name}" Width="110"/>
                            <GridViewColumn Header="Offset" DisplayMemberBinding="{Binding DataOffsetHex}" Width="90"/>
                            <GridViewColumn Header="Size" DisplayMemberBinding="{Binding Size}" Width="80"/>
                            <GridViewColumn Header="Parser" DisplayMemberBinding="{Binding ParserStatus}" Width="180"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <TextBox Grid.Row="1"
                         Grid.Column="2"
                         FontFamily="Consolas"
                         Text="{Binding PreviewText}"
                         TextWrapping="Wrap"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
