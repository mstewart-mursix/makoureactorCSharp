<Window x:Class="MakouReactor.UI.WPF.Search.SearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find" Height="520" Width="820"
        WindowStartupLocation="CenterOwner"
        MinHeight="360" MinWidth="620">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusLabel" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>

        <ToolBar DockPanel.Dock="Top" Height="32">
            <TextBlock VerticalAlignment="Center" Text="Find:" Margin="4,0,6,0"/>
            <TextBox x:Name="QueryBox" Width="260" VerticalContentAlignment="Center" KeyDown="QueryBox_KeyDown"/>
            <Button Margin="6,0,0,0" Padding="10,2" Click="Search_Click">Search</Button>
            <Separator/>
            <CheckBox x:Name="AllFieldsCheckBox" VerticalAlignment="Center" Content="All fields" Margin="0,0,8,0"/>
            <TextBlock x:Name="ScopeLabel" VerticalAlignment="Center" Foreground="#555"/>
        </ToolBar>

        <ListView x:Name="ResultsListView" Margin="6" MouseDoubleClick="ResultsListView_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Kind" DisplayMemberBinding="{Binding Kind}" Width="90"/>
                    <GridViewColumn Header="Location" DisplayMemberBinding="{Binding Location}" Width="280"/>
                    <GridViewColumn Header="Match" DisplayMemberBinding="{Binding Match}" Width="320"/>
                    <GridViewColumn Header="Field" DisplayMemberBinding="{Binding FieldName}" Width="90"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
