<Window x:Class="MakouReactor.UI.WPF.Texts.TextManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Texts" Height="520" Width="760"
        WindowStartupLocation="CenterOwner"
        MinHeight="380" MinWidth="560">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusLabel" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>

        <ToolBar DockPanel.Dock="Top" Height="30">
            <Button x:Name="AddTextButton" Width="24" ToolTip="Add text" Click="AddText_Click">+</Button>
            <Button x:Name="RemoveTextButton" Width="24" ToolTip="Remove text" Click="RemoveText_Click">-</Button>
            <Separator/>
            <TextBox x:Name="SearchBox"
                     Width="180"
                     Height="22"
                     VerticalContentAlignment="Center"
                     ToolTip="Search text"
                     KeyDown="SearchBox_KeyDown"/>
            <Button ToolTip="Find next text"
                    Margin="4,0,0,0"
                    Click="SearchNext_Click">Search</Button>
            <Separator/>
            <ComboBox x:Name="TokenComboBox"
                      Width="165"
                      Height="24"
                      VerticalContentAlignment="Center"
                      ToolTip="Text control token">
                <ComboBoxItem Content="Cloud" Tag="{}{CLOUD}"/>
                <ComboBoxItem Content="Barret" Tag="{}{BARRET}"/>
                <ComboBoxItem Content="Tifa" Tag="{}{TIFA}"/>
                <ComboBoxItem Content="Aerith" Tag="{}{AERITH}"/>
                <ComboBoxItem Content="Red XIII" Tag="{}{RED XIII}"/>
                <ComboBoxItem Content="New page" Tag="{}{NEW PAGE}"/>
                <ComboBoxItem Content="Choice" Tag="{}{CHOICE}"/>
                <ComboBoxItem Content="Red text" Tag="{}{RED}"/>
                <ComboBoxItem Content="Blue text" Tag="{}{BLUE}"/>
                <ComboBoxItem Content="White text" Tag="{}{WHITE}"/>
                <ComboBoxItem Content="Circle" Tag="{}{CIRCLE}"/>
                <ComboBoxItem Content="Cross" Tag="{}{CROSS}"/>
            </ComboBox>
            <Button ToolTip="Insert selected token"
                    Margin="4,0,0,0"
                    Click="InsertToken_Click">Insert</Button>
            <Separator/>
            <TextBlock x:Name="FieldLabel" VerticalAlignment="Center" Foreground="#555"/>
        </ToolBar>

        <Grid Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListView x:Name="TextListView" SelectionChanged="TextListView_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Id" DisplayMemberBinding="{Binding Id}" Width="48"/>
                        <GridViewColumn Header="Length" DisplayMemberBinding="{Binding Length}" Width="58"/>
                        <GridViewColumn Header="Preview" DisplayMemberBinding="{Binding Preview}" Width="130"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="120"/>
                </Grid.RowDefinitions>

                <GroupBox Header="Text">
                    <DockPanel Margin="6">
                        <Button DockPanel.Dock="Bottom"
                                x:Name="ApplyTextButton"
                                Width="90"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Right"
                                Click="ApplyText_Click">Apply</Button>
                        <TextBox x:Name="TextEditor"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"/>
                    </DockPanel>
                </GroupBox>

                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch"/>

                <GroupBox Grid.Row="2" Header="Preview">
                    <Border Margin="6" Background="#1F1F1F" BorderBrush="#333" BorderThickness="1">
                        <TextBlock x:Name="PreviewText"
                                   Margin="10"
                                   Foreground="#F2F2F2"
                                   TextWrapping="Wrap"/>
                    </Border>
                </GroupBox>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
