<Window x:Class="MakouReactor.UI.WPF.AI.LLMSceneDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LLM Scene Generator"
        Width="1100" Height="720" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="110"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="BackendLabel" FontWeight="SemiBold" Text="Backend: codex"/>
            <TextBlock x:Name="FieldContextLabel" Margin="0,3,0,0" Foreground="#555"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Margin="0,0,0,4"
                   Text="Scene description (characters, motivations, setting):"/>

        <TextBox Grid.Row="2" x:Name="PromptBox"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"/>

        <WrapPanel Grid.Row="3" Margin="0,8,0,4">
            <CheckBox x:Name="GenDialogCheck" Content="Dialogue" IsChecked="True" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <CheckBox x:Name="GenLayoutCheck" Content="Layout" IsChecked="True" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <CheckBox x:Name="GenScriptsCheck" Content="Scripts" IsChecked="True" Margin="0,0,16,0" VerticalAlignment="Center"/>
            <TextBlock Text="Walkmesh:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox x:Name="WalkmeshModeBox" Width="200" Margin="0,0,16,0" SelectedIndex="0"
                      ToolTip="What to do with a walkmesh the model proposes. Ignore never touches the field's walkmesh."
                      SelectionChanged="WalkmeshModeBox_SelectionChanged">
                <ComboBoxItem Content="Ignore (safe)"/>
                <ComboBoxItem Content="Merge into existing"/>
                <ComboBoxItem Content="Replace existing"/>
            </ComboBox>
            <Button x:Name="GenerateButton" Content="Generate" Width="100" Click="GenerateButton_Click"/>
            <Button x:Name="ApplyButton" Content="Apply" Width="90" Margin="8,0,0,0"
                    IsEnabled="False" Click="ApplyButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Margin="8,0,0,0"
                    IsEnabled="False" Click="CancelButton_Click"/>
            <ProgressBar x:Name="GenerationProgress"
                         Width="140"
                         Height="18"
                         Margin="12,0,0,0"
                         IsIndeterminate="True"
                         Visibility="Collapsed"/>
        </WrapPanel>

        <Grid Grid.Row="4" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Refine:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Grid.Column="1" x:Name="RefineBox" IsEnabled="False"
                     ToolTip="Ask for a change to the current plan, e.g. 'make the blacksmith angrier' or 'add a battle at the end'."/>
            <Button Grid.Column="2" x:Name="RefineButton" Content="Refine" Width="90" Margin="8,0,0,0"
                    IsEnabled="False" Click="RefineButton_Click"/>
        </Grid>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1.8*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1.7*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="History">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox x:Name="HistoryList" DisplayMemberPath="Title"
                             SelectionChanged="HistoryList_SelectionChanged"/>
                    <Button Grid.Row="1" x:Name="ClearHistoryButton" Content="Clear history" Margin="0,6,0,0"
                            Click="ClearHistoryButton_Click"/>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Generated scene plan (JSON)">
                <TextBox x:Name="OutputBox" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="12"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"/>
            </GroupBox>

            <GroupBox Grid.Column="4" Header="Changes to the field">
                <TextBox x:Name="PreviewSummaryBox"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         FontSize="12"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
            </GroupBox>

            <GroupBox Grid.Column="6" Header="Validation">
                <ListBox x:Name="IssuesList" FontFamily="Consolas" FontSize="12"/>
            </GroupBox>
        </Grid>

        <StatusBar Grid.Row="6" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusLabel" Text="Ready"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="ElapsedLabel" Text=""/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
