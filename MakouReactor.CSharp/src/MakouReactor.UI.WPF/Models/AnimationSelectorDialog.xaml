<Window x:Class="MakouReactor.UI.WPF.Models.AnimationSelectorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:preview="clr-namespace:MakouReactor.UI.WPF.Preview"
        Title="Animation Selector"
        Height="380"
        Width="640"
        MinHeight="300"
        MinWidth="520"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8">
            <Button Width="86" Margin="0,0,6,0" IsDefault="True" Click="Ok_Click">OK</Button>
            <Button Width="86" IsCancel="True">Cancel</Button>
        </StackPanel>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListView x:Name="AnimationListView" SelectionChanged="AnimationListView_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Id" DisplayMemberBinding="{Binding Id}" Width="44"/>
                        <GridViewColumn Header="Animation" DisplayMemberBinding="{Binding Name}" Width="128"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="AnimationLabel"
                           Margin="0,0,0,8"
                           TextWrapping="Wrap"
                           Foreground="#555"/>
                <preview:ModelPreviewControl x:Name="ModelPreview" Grid.Row="1"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
