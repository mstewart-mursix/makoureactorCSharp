<UserControl x:Class="MakouReactor.UI.WPF.Shell.CodexSetupBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <Border Background="#FFFFF4CE" BorderBrush="#FFE0C060" BorderThickness="0,0,0,1" Padding="8,4">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CopyInstallButton" Content="Copy install command" Margin="4,0" Padding="8,1" Click="CopyInstallButton_Click"/>
                <Button x:Name="LoginButton" Content="Log in..." Margin="4,0" Padding="8,1" Click="LoginButton_Click"/>
                <Button x:Name="RecheckButton" Content="Recheck" Margin="4,0" Padding="8,1" Click="RecheckButton_Click"/>
                <Button x:Name="DismissButton" Content="Dismiss" Margin="4,0" Padding="8,1" Click="DismissButton_Click"/>
            </StackPanel>
            <TextBlock x:Name="MessageText" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Border>
</UserControl>
