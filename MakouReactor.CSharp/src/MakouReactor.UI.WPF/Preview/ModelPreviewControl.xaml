<UserControl x:Class="MakouReactor.UI.WPF.Preview.ModelPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="100">
    <Border Background="#242424"
            BorderBrush="#202020"
            BorderThickness="1">
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="ModelGlyphPanel"
                  Width="120"
                  Height="118"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  ToolTip="Parsed model loader preview">
                <Ellipse Width="42"
                         Height="42"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top"
                         Fill="{Binding ElementName=ColorSwatch, Path=Background}"
                         Stroke="#CFCFCF"
                         StrokeThickness="1.2"/>
                <Border Width="54"
                        Height="54"
                        CornerRadius="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{Binding ElementName=ColorSwatch, Path=Background}"
                        BorderBrush="#CFCFCF"
                        BorderThickness="1.2"/>
                <Border Width="18"
                        Height="58"
                        Margin="22,52,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="#6F6F6F"
                        BorderBrush="#B8B8B8"
                        BorderThickness="1"/>
                <Border Width="18"
                        Height="58"
                        Margin="0,52,22,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="#6F6F6F"
                        BorderBrush="#B8B8B8"
                        BorderThickness="1"/>
            </Grid>

            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText"
                           Foreground="#F0F0F0"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SubtitleText"
                           Margin="0,3,0,8"
                           Foreground="#B8B8B8"
                           TextTrimming="CharacterEllipsis"/>

                <UniformGrid Columns="4" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Foreground="#8E8E8E" FontSize="11" Text="HRC"/>
                        <TextBlock x:Name="HrcText" Foreground="#E2E2E2" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Foreground="#8E8E8E" FontSize="11" Text="Scale"/>
                        <TextBlock x:Name="ScaleText" Foreground="#E2E2E2"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Foreground="#8E8E8E" FontSize="11" Text="Animations"/>
                        <TextBlock x:Name="AnimationCountText" Foreground="#E2E2E2"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Border x:Name="ColorSwatch"
                                Width="22"
                                Height="22"
                                Margin="0,0,6,0"
                                BorderBrush="#CFCFCF"
                                BorderThickness="1"/>
                        <TextBlock x:Name="ColorText"
                                   Foreground="#E2E2E2"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </UniformGrid>

                <ItemsControl x:Name="AnimationItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,6,4"
                                    Padding="6,2"
                                    Background="#383838"
                                    BorderBrush="#4A4A4A"
                                    BorderThickness="1">
                                <TextBlock Foreground="#DADADA"
                                           Text="{Binding}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="120"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock x:Name="EmptyText"
                       Grid.ColumnSpan="3"
                       Foreground="#B0B0B0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
        </Grid>
    </Border>
</UserControl>
