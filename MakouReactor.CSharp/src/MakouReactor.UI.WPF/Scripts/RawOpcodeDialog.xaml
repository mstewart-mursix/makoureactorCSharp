<Window x:Class="MakouReactor.UI.WPF.Scripts.RawOpcodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Raw Opcode"
        Width="560"
        Height="420"
        MinWidth="460"
        MinHeight="320"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="StatusLabel" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="#A85600"/>
            <Button Width="86" Margin="0,0,6,0" IsDefault="True" Click="Apply_Click">Apply</Button>
            <Button Width="86" IsCancel="True">Cancel</Button>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,8" FontWeight="SemiBold" Text="Offset"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Text="{Binding OffsetHex}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,8" FontWeight="SemiBold" Text="Opcode"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Name}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,10,8" FontWeight="SemiBold" Text="Id"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Text="{Binding IdHex}"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,10,8" FontWeight="SemiBold" Text="Size"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Text="{Binding SizeLabel}"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,10,8" FontWeight="SemiBold" Text="Arguments"/>
            <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" TextWrapping="Wrap" Text="{Binding Arguments}"/>

            <GroupBox x:Name="TypedEditorPanel"
                      Grid.Row="5"
                      Grid.ColumnSpan="2"
                      Header="Typed editor"
                      Margin="0,0,0,8"
                      Visibility="Collapsed">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TypedWindowLabel" Grid.Row="0" Grid.Column="0" Margin="0,0,8,6" Text="Window"/>
                    <TextBox x:Name="TypedWindowBox" Grid.Row="0" Grid.Column="1" Width="90" HorizontalAlignment="Left" Margin="0,0,0,6"/>

                    <TextBlock x:Name="TypedTextLabel" Grid.Row="1" Grid.Column="0" Margin="0,0,8,6" Text="Text"/>
                    <TextBox x:Name="TypedTextBox" Grid.Row="1" Grid.Column="1" Width="90" HorizontalAlignment="Left" Margin="0,0,0,6"/>

                    <TextBlock x:Name="TypedXLabel" Grid.Row="2" Grid.Column="0" Margin="0,0,8,6" Text="X" Visibility="Collapsed"/>
                    <TextBox x:Name="TypedXBox" Grid.Row="2" Grid.Column="1" Width="90" HorizontalAlignment="Left" Margin="0,0,0,6" Visibility="Collapsed"/>

                    <TextBlock x:Name="TypedYLabel" Grid.Row="3" Grid.Column="0" Margin="0,0,8,6" Text="Y" Visibility="Collapsed"/>
                    <TextBox x:Name="TypedYBox" Grid.Row="3" Grid.Column="1" Width="90" HorizontalAlignment="Left" Margin="0,0,0,6" Visibility="Collapsed"/>

                    <TextBlock x:Name="TypedWidthLabel" Grid.Row="4" Grid.Column="0" Margin="0,0,8,6" Text="Width" Visibility="Collapsed"/>
                    <TextBox x:Name="TypedWidthBox" Grid.Row="4" Grid.Column="1" Width="90" HorizontalAlignment="Left" Margin="0,0,0,6" Visibility="Collapsed"/>

                    <TextBlock x:Name="TypedHeightLabel" Grid.Row="5" Grid.Column="0" Margin="0,0,8,0" Text="Height" Visibility="Collapsed"/>
                    <TextBox x:Name="TypedHeightBox" Grid.Row="5" Grid.Column="1" Width="90" HorizontalAlignment="Left" Visibility="Collapsed"/>

                    <TextBlock x:Name="TypedExtra1Label" Grid.Row="6" Grid.Column="0" Margin="0,0,8,6" Text="Extra" Visibility="Collapsed"/>
                    <TextBox x:Name="TypedExtra1Box" Grid.Row="6" Grid.Column="1" Width="90" HorizontalAlignment="Left" Margin="0,0,0,6" Visibility="Collapsed"/>

                    <TextBlock x:Name="TypedExtra2Label" Grid.Row="7" Grid.Column="0" Margin="0,0,8,0" Text="Extra" Visibility="Collapsed"/>
                    <TextBox x:Name="TypedExtra2Box" Grid.Row="7" Grid.Column="1" Width="90" HorizontalAlignment="Left" Visibility="Collapsed"/>
                </Grid>
            </GroupBox>

            <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,2,10,8" FontWeight="SemiBold" Text="Raw bytes"/>
            <TextBox Grid.Row="6" Grid.Column="1"
                     x:Name="RawBytesBox"
                     FontFamily="Consolas"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding RawBytesHex}"/>

            <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,8,10,0" FontWeight="SemiBold" Text="Warning"/>
            <TextBlock Grid.Row="7" Grid.Column="1" Margin="0,8,0,0" Foreground="#A85600" TextWrapping="Wrap" Text="{Binding Warning}"/>
        </Grid>
    </DockPanel>
</Window>
