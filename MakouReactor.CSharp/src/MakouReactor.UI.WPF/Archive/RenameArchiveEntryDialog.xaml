<Window x:Class="MakouReactor.UI.WPF.Archive.RenameArchiveEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename Archive Entry"
        Width="460"
        Height="170"
        MinWidth="360"
        MinHeight="160"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Width="86" Margin="0,0,6,0" IsDefault="True" Click="Ok_Click">OK</Button>
            <Button Width="86" IsCancel="True">Cancel</Button>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Margin="0,0,0,6" Text="Archive-local path"/>
            <TextBox x:Name="ArchivePathBox" Grid.Row="1" Height="24"/>
            <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,6,0,0" Foreground="#A85600"/>
        </Grid>
    </DockPanel>
</Window>
