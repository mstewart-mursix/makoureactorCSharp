<Window x:Class="MakouReactor.UI.WPF.Background.BackgroundDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:preview="clr-namespace:MakouReactor.UI.WPF.Preview"
        Title="Background" Height="620" Width="1040"
        WindowStartupLocation="CenterOwner"
        MinHeight="460" MinWidth="780">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusLabel" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>

        <ToolBar DockPanel.Dock="Top" Height="30">
            <TextBlock x:Name="FieldLabel" VerticalAlignment="Center" Foreground="#555"/>
            <Separator/>
            <Button x:Name="ImportBackgroundButton" ToolTip="Import raw background section" Click="ImportBackground_Click">Import</Button>
            <Button x:Name="ExportBackgroundButton" ToolTip="Export raw background section" Click="ExportBackground_Click">Export</Button>
            <Button ToolTip="Add tile" IsEnabled="False">+</Button>
            <Button ToolTip="Remove tile" IsEnabled="False">-</Button>
        </ToolBar>

        <Grid Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="170"/>
            </Grid.RowDefinitions>

            <UniformGrid Columns="4" Margin="0,0,0,6">
                <TextBlock x:Name="SectionSizeLabel"/>
                <TextBlock x:Name="TileCountLabel"/>
                <TextBlock x:Name="TextureCountLabel"/>
                <TextBlock x:Name="TextureOffsetLabel"/>
            </UniformGrid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ListView x:Name="LayerListView" SelectionChanged="LayerListView_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Layer" DisplayMemberBinding="{Binding Name}" Width="72"/>
                            <GridViewColumn Header="Enabled" DisplayMemberBinding="{Binding Exists}" Width="70"/>
                            <GridViewColumn Header="Tiles" DisplayMemberBinding="{Binding VisibleTileCount}" Width="54"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>

                <ListView x:Name="TileListView" Grid.Column="2">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="#" DisplayMemberBinding="{Binding TileId}" Width="46"/>
                            <GridViewColumn Header="Dst" DisplayMemberBinding="{Binding Destination}" Width="82"/>
                            <GridViewColumn Header="Src" DisplayMemberBinding="{Binding Source}" Width="72"/>
                            <GridViewColumn Header="Tex" DisplayMemberBinding="{Binding TextureId}" Width="48"/>
                            <GridViewColumn Header="Pal" DisplayMemberBinding="{Binding PaletteId}" Width="48"/>
                            <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="62"/>
                            <GridViewColumn Header="Param" DisplayMemberBinding="{Binding Param}" Width="56"/>
                            <GridViewColumn Header="State" DisplayMemberBinding="{Binding State}" Width="56"/>
                            <GridViewColumn Header="Blend" DisplayMemberBinding="{Binding Blending}" Width="58"/>
                            <GridViewColumn Header="Depth" DisplayMemberBinding="{Binding Depth}" Width="52"/>
                            <GridViewColumn Header="Size" DisplayMemberBinding="{Binding Size}" Width="52"/>
                            <GridViewColumn Header="Offset" DisplayMemberBinding="{Binding Offset}" Width="70"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>

            <Grid Grid.Row="2" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <ListView x:Name="TextureListView">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Texture" DisplayMemberBinding="{Binding TextureId}" Width="62"/>
                            <GridViewColumn Header="Exists" DisplayMemberBinding="{Binding Exists}" Width="58"/>
                            <GridViewColumn Header="Tile Size" DisplayMemberBinding="{Binding TileSize}" Width="76"/>
                            <GridViewColumn Header="Depth" DisplayMemberBinding="{Binding Depth}" Width="58"/>
                            <GridViewColumn Header="Data Offset" DisplayMemberBinding="{Binding DataOffset}" Width="88"/>
                            <GridViewColumn Header="Data Size" DisplayMemberBinding="{Binding DataSize}" Width="90"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>

                <preview:BackgroundPreviewControl x:Name="BackgroundPreview" Grid.Column="2"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
