<Window x:Class="MakouReactor.UI.WPF.AI.LLMSceneDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LLM Scene Generator"
        Width="900" Height="650" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="BackendLabel" FontWeight="SemiBold" Text="Backend: codex"/>
            <TextBlock x:Name="FieldContextLabel" Margin="0,3,0,0" Foreground="#555"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Margin="0,0,0,4"
                   Text="Scene description (characters, motivations, setting):"/>

        <TextBox Grid.Row="2" x:Name="PromptBox"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,8">
            <CheckBox x:Name="GenDialogCheck" Content="Dialogue" IsChecked="True" Margin="0,0,12,0"/>
            <CheckBox x:Name="GenLayoutCheck" Content="Layout" IsChecked="True" Margin="0,0,12,0"/>
            <CheckBox x:Name="GenScriptsCheck" Content="Scripts" IsChecked="True" Margin="0,0,24,0"/>
            <Button x:Name="GenerateButton" Content="Generate" Width="110" Click="GenerateButton_Click"/>
            <Button x:Name="ApplyButton" Content="Apply" Width="90" Margin="8,0,0,0"
                    IsEnabled="False" Click="ApplyButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Margin="8,0,0,0"
                    IsEnabled="False" Click="CancelButton_Click"/>
            <ProgressBar x:Name="GenerationProgress"
                         Width="140"
                         Height="18"
                         Margin="12,0,0,0"
                         IsIndeterminate="True"
                         Visibility="Collapsed"/>
        </StackPanel>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.4*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1.7*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1.7*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Generated scene plan (JSON)">
                <TextBox x:Name="OutputBox" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="12"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"/>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Preview summary">
                <TextBox x:Name="PreviewSummaryBox"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         FontSize="12"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
            </GroupBox>

            <GroupBox Grid.Column="4" Header="Validation">
                <ListBox x:Name="IssuesList" FontFamily="Consolas" FontSize="12"/>
            </GroupBox>
        </Grid>

        <StatusBar Grid.Row="5" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusLabel" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
