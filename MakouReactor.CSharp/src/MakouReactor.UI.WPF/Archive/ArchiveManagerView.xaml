<UserControl x:Class="MakouReactor.UI.WPF.Archive.ArchiveManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <ToolBar DockPanel.Dock="Top" Height="30">
                <Button x:Name="ExtractCurrentButton"
                        ToolTip="Extract current"
                        IsEnabled="False"
                        Click="ExtractCurrentButton_Click">Extract</Button>
                <Button x:Name="ExtractAllButton"
                        ToolTip="Extract all"
                        IsEnabled="False"
                        Click="ExtractAllButton_Click">Extract All</Button>
                <Separator/>
                <Button x:Name="ReplaceCurrentButton"
                        ToolTip="Replace current"
                        IsEnabled="False"
                        Click="ReplaceCurrentButton_Click">Replace</Button>
                <Button x:Name="AddButton"
                        ToolTip="Add file"
                        IsEnabled="False"
                        Click="AddButton_Click">Add</Button>
                <Button x:Name="RemoveCurrentButton"
                        ToolTip="Remove current"
                        IsEnabled="False"
                        Click="RemoveCurrentButton_Click">Remove</Button>
                <Button x:Name="RenameCurrentButton"
                        ToolTip="Rename or move current"
                        IsEnabled="False"
                        Click="RenameCurrentButton_Click">Rename</Button>
            </ToolBar>
            <ListView x:Name="EntriesList" SelectionChanged="EntriesList_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn DisplayMemberBinding="{Binding Name}" Width="180">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="Name" Tag="Name" Click="ColumnHeader_Click"/>
                            </GridViewColumn.Header>
                        </GridViewColumn>
                        <GridViewColumn DisplayMemberBinding="{Binding FullPath}" Width="260">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="Path" Tag="FullPath" Click="ColumnHeader_Click"/>
                            </GridViewColumn.Header>
                        </GridViewColumn>
                        <GridViewColumn DisplayMemberBinding="{Binding Directory}" Width="160">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="Directory" Tag="Directory" Click="ColumnHeader_Click"/>
                            </GridViewColumn.Header>
                        </GridViewColumn>
                        <GridViewColumn DisplayMemberBinding="{Binding Size}" Width="90">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="Size" Tag="Size" Click="ColumnHeader_Click"/>
                            </GridViewColumn.Header>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>

        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>

        <Border Grid.Column="2" BorderBrush="#D6D6D6" BorderThickness="1" Background="#FAFAFA">
            <Grid>
                <Image x:Name="PreviewImage"
                       Margin="6"
                       Stretch="Uniform"
                       Visibility="Collapsed"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <TextBlock x:Name="PreviewLabel" Margin="10"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#777" TextAlignment="Center"
                               TextWrapping="Wrap"
                               Text="Archive preview will appear here."/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
