<Window x:Class="MakouReactor.UI.WPF.Variables.VariableManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Variable Manager" Height="520" Width="860"
        WindowStartupLocation="CenterOwner"
        MinHeight="360" MinWidth="620">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusLabel" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>

        <ToolBar DockPanel.Dock="Top" Height="30">
            <TextBlock x:Name="FieldLabel" VerticalAlignment="Center" Foreground="#555" Text="{Binding FieldName}"/>
            <Separator/>
            <TextBlock VerticalAlignment="Center" Margin="0,0,4,0" Text="Filter"/>
            <TextBox x:Name="QueryBox"
                     Width="180"
                     Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Button x:Name="ClearFilterButton" ToolTip="Clear filter" Click="ClearFilter_Click">Clear</Button>
            <Separator/>
            <Button x:Name="GoToReferenceButton"
                    ToolTip="Go to selected variable reference"
                    IsEnabled="{Binding HasSelectedReference}"
                    Click="GoToReference_Click">Go To</Button>
        </ToolBar>

        <ListView x:Name="VariableListView"
                  Margin="6"
                  ItemsSource="{Binding References}"
                  SelectedItem="{Binding SelectedReference, Mode=TwoWay}"
                  MouseDoubleClick="VariableListView_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Bank" DisplayMemberBinding="{Binding BankHex}" Width="70"/>
                    <GridViewColumn Header="Address" DisplayMemberBinding="{Binding AddressHex}" Width="80"/>
                    <GridViewColumn Header="Size" DisplayMemberBinding="{Binding Size}" Width="80"/>
                    <GridViewColumn Header="Writable" DisplayMemberBinding="{Binding Writable}" Width="70"/>
                    <GridViewColumn Header="Opcode" DisplayMemberBinding="{Binding OpcodeName}" Width="90"/>
                    <GridViewColumn Header="Location" DisplayMemberBinding="{Binding Location}" Width="420"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
